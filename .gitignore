# 运行期数据（上传的论文、术语、译文、导出文件）
data/
*.log

# 密钥：只提交 .env.example
.env
.env.local
.env.*.local
!.env.example

# 临时目录与浏览器配置
.tmp/
.chrome-profile/

# 测试生成的截图（README 用的精选图在 docs/images/）
shots/

# 体积大的设计稿与第三方论文样例
docs/*.pptx
fixtures/*.pdf

# 系统文件
Thumbs.db
Desktop.ini
.DS_Store
