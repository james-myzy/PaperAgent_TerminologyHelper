# ------------------------------------------------------------------
# 模型配置（OpenAI 兼容协议，DeepSeek / 通义千问 / 智谱 / 本地 vLLM 都行）
# ------------------------------------------------------------------
# 不填 API Key 时自动进入「离线演示模式」：界面、工具链路、导出都能走通，
# 只是回复内容是脚本化的，用来验证流程。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 服务端口
PORT=8787

# 单轮对话最多几步「模型思考 + 工具调用」
AGENT_MAX_STEPS=6

# 术语抽取的成本控制：每次送给模型的最大字符数、最多分几块
TERM_CHUNK_CHARS=2600
TERM_MAX_CHUNKS=8

# 单次模型请求超时（毫秒）
LLM_TIMEOUT_MS=120000
